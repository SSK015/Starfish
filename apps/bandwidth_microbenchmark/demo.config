# Single memory node, 4000-byte object bandwidth demo.
# The launcher appends the bootstrap address, TCP port and local InfiniBand port.
server_count 1
server_buffer_size 30474836480
client_buffer_size 5506789120
evict_batch_size 65536
qp_count 1
max_thread_cnt 24
evacuate_thread_cnt 10
mark_thread_cnt 6
optimized_evacuator 1
enable_eager_evict 1
exclusive_cache 1
ft_method none
behavior_group 0
ft_background_rebuild 0
enable_selective_backup 0
enable_region_resident_placement 0
local_resident_budget_bytes 0
