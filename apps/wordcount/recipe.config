# Client configuration for the Wordcount full-dictionary correctness fixture.
# Run six active endpoints plus a connected standby at index 6. Update
# server_addrs/server_ports for your fabric and set
# ib_device_name to the compute node's active InfiniBand device.
server_count 7
server_addr 192.0.2.10
server_port 18930
server_addrs 192.0.2.10,192.0.2.10,192.0.2.10,192.0.2.11,192.0.2.11,192.0.2.11,192.0.2.11
server_ports 18930,18931,18932,18933,18934,18935,18936
server_buffer_size 268435456
client_buffer_size 16777216
ib_device_name mlx5_1
max_thread_cnt 4
evacuate_thread_cnt 2
mark_thread_cnt 1
exclusive_cache 1
optimized_evacuator 1
enable_eager_evict 1
evict_batch_size 65536
qp_count 1
qp_timeout 4
qp_retry_cnt 0
remote_mapping stripe
stripe_size_bytes 1048576
ft_method ec_batch
ft_small_object_cutoff 4096
ft_small_stripe_shard_size_bytes 262144
ft_ec_data_shards 4
ft_ec_parity_shards 2
ft_standby_endpoint 6
enable_selective_backup 0
local_resident_budget_bytes 0
enable_resident_profile_planner 0
enable_region_resident_placement 0
enable_region_hotness_placement 0
enable_region_fetch_hotness_placement 0
