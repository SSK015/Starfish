root = true

[{runtime/include,runtime/src,tests}/**.{h,hpp,cc,cpp,ipp}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 80

# Keep the embedded upstream generator outside the Starfish style policy.
[runtime/include/lib/zipfian.hpp]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
max_line_length = unset
